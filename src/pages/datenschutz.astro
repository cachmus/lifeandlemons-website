---
import Base from '../layouts/Base.astro';
import Platzhalter from '../components/Platzhalter.astro';
---

<Base title="Datenschutzerklärung" description="Datenschutzerklärung von Life&Lemons.">
  <section class="section">
    <div class="container text">
      <h1>Datenschutzerklärung</h1>
      <Platzhalter>
        <p>ENTWURF FOLGT. Vor dem Livegang fachlich prüfen lassen.</p>
        <p>Vorgesehene Abschnitte, abgestimmt auf den tatsächlichen technischen Aufbau:</p>
        <ul>
          <li>Verantwortliche</li>
          <li>Hosting bei Netlify und Server-Logdateien</li>
          <li>Kontakt per E-Mail</li>
          <li>Links zu externen Bestellformularen (Digistore24)</li>
          <li>Newsletter über Brevo (erst mit Sprint 2)</li>
          <li>Keine Cookies, kein Tracking, Schriften lokal eingebunden</li>
          <li>Rechte der betroffenen Personen</li>
        </ul>
      </Platzhalter>
    </div>
  </section>
</Base>
