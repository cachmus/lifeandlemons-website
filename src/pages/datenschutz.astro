    font-size: clamp(44px, 6vw, 72px);
    margin-bottom: 0.4em;
    hyphens: manual;
  }
  .recht__knopf {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    color: var(--terrakotta-tief);
    text-decoration: underline;
    cursor: pointer;
  }
  .recht h2 {
    font-size: clamp(26px, 2.6vw, 34px);
    margin-top: 1.6em;
  }
