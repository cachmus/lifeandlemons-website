---
/**
 * Startseite. Wortlaut: Positionierungspapier V4 (30.10.2026), Teil C § 17, mit den Entscheidungen in
 * claude/Website_V2_Umbau.md (Projekt in claude.ai). Texte nicht stillschweigend ändern.
 * Reihenfolge der Abschnitte folgt den Stufen Wiedererkennen, Verstehen, Methode, Vertrauen, Entscheidung.
 * Preise und Fristen kommen aus src/config/angebote.ts.
 */
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AngebotButton from '../components/AngebotButton.astro';
import Preis from '../components/Preis.astro';
import Treppe from '../components/Treppe.astro';
import ModulKarte from '../components/ModulKarte.astro';
import Polaroid from '../components/Polaroid.astro';
import Interessentenliste from '../components/Interessentenliste.astro';
import { site, seiten } from '../config/site';
import { angebotNachId, aktuellerPreis, bestellHinweis, formatEuro, formatDatum, STICHTAGE } from '../config/angebote';
import portraet from '../assets/portraet-christine-mauer.jpg';
import kursbuchFoto from '../assets/kursbuch-vorder-und-rueckseite.jpg';
import zweitesFoto from '../assets/portraet-christine-4x5.jpg';

const kursbuch = angebotNachId('kursbuch');
const kursbuchPreis = aktuellerPreis(kursbuch);
const kursbuchHinweis = bestellHinweis(kursbuch);

/** Stimmen erst einblenden, wenn echte Stimmen mit schriftlicher Einwilligung vorliegen */
const stimmenZeigen = false;

const fragen = [
  'Mein Leben funktioniert, aber es fühlt sich nicht ganz nach meinem Leben an.',
  'Ich weiß, dass ich etwas verändern möchte, aber noch nicht genau, was.',
  'Ich nehme mir viel vor und falle doch immer wieder in alte Muster zurück.',
  'Ich möchte herausfinden, welche Richtung wirklich zu mir passt.',
];

const leben = [
  { titel: 'Weitergehen', frage: 'Was ändert sich, wenn du deinen Weg mutiger gehst?' },
  { titel: 'Umsteigen', frage: 'Was baust du auf, wenn dein bisheriger Weg wegfällt?' },
  { titel: 'Wagen', frage: 'Was tust du, wenn ein Scheitern dich nicht aus der Bahn werfen kann?' },
];

const hilft = [
  'Du wählst eine kleine Aufgabe, die du bisher aufgeschoben hast.',
  'Ein Wenn-dann-Plan legt fest, wann und wo du sie erledigst.',
  'Ein Mensch, dem du davon erzählst, macht daraus eine kleine Verabredung.',
  'Du merkst: Ich habe getan, was ich mir vorgenommen habe. Der nächste Schritt darf größer werden.',
];
---

<Base
  dunklerSchluss
  title="Life&Lemons · Life Coaching und Mentoring in Hannover und online"
  description="Mentoring und Life Coaching von Christine Achmus, in Hannover und online: Du entwirfst drei mögliche Leben, testest sie im Alltag und findest heraus, welcher Weg deiner wird."
>
  <!-- 1. Erster Bildschirm · Wiedererkennen -->
  <section class="hero">
    <div class="container hero__innen">
      <div class="hero__text">
        <p class="label">Mentoring für selbstbestimmte Lebensgestaltung · {site.inhaberin} · {site.ort.stadt} und online</p>
        <h1>Sei, wer du werden <span class="pivot">willst</span>.</h1>
        <p class="unterzeile">
          Mit drei völlig unterschiedlichen Lebensentwürfen und praktischen Tests im Alltag findest du heraus, welcher Weg deiner
          werden soll.
        </p>
        <div class="aktionen">
          <a class="button" href="#weg">Finde deinen Einstieg <span class="button__pfeil" aria-hidden="true">→</span></a>
          <a class="textlink" href="#ueber">Lerne mich kennen</a>
        </div>
        <a class="neu" href="#kursbuch">
          <span class="neu__label">Neu</span>
          <span class="neu__text">
            Das Kursbuch „Entwirf dein Zukunfts-Ich“
            {kursbuchPreis && (
              <span class="neu__preis">
                {` · ${formatEuro(kursbuchPreis.betrag)}${kursbuchPreis.einfuehrung ? ` Einführungspreis bis ${formatDatum(STICHTAGE.einfuehrungBis)}` : ''}`}
              </span>
            )}
          </span>
        </a>
      </div>

      <div class="hero__bild">
        <Picture
          src={portraet}
          alt="Christine Achmus, Mentorin für Lebensentwürfe, lächelnd vor einer alten Backsteinwand"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[420, 640, 860, 1024]}
          sizes="(max-width: 860px) 92vw, 46vw"
          loading="eager"
          fetchpriority="high"
          quality={80}
        />
      </div>
    </div>
  </section>

  <!-- 2. Ausgangslage · Wiedererkennen -->
  <section class="abschnitt" aria-labelledby="ausgangslage-titel">
    <div class="container">
      <div class="kopfblock">
        <p class="label">01 · Ausgangslage</p>
        <h2 id="ausgangslage-titel" class="zeile">Fragen, mit denen Menschen zu <span class="pivot">mir</span> kommen</h2>
      </div>
      <ul class="fragen">
        {
          fragen.map((frage) => (
            <li data-erscheinen>
              <blockquote>
                <p>
                  <span class="fragen__auf" aria-hidden="true">„</span>
                  {frage}“
                </p>
              </blockquote>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. So entsteht dein Weg · Verstehen -->
  <section class="abschnitt" id="weg" aria-labelledby="weg-titel">
    <div class="container">
      <div class="kopfblock">
        <p class="label">02 · Dein Weg</p>
        <h2 id="weg-titel" class="zeile">So entsteht dein <span class="pivot">Weg</span></h2>
        <p class="einleitung text">
          Zu mir kommen Menschen, die spüren, dass sich etwas ändern soll, und noch nicht wissen, wohin. Wenn du dich darin
          wiedererkennst, findest du mithilfe meines Methodenwerks heraus, welche inneren Muster dich bislang gebremst haben. Du
          entwirfst drei völlig unterschiedliche Leben und testest den Entwurf, der dich am meisten anzieht, im Alltag, bevor du
          dich festlegst. Jeder Schritt, den du gehst, setzt den alten Mustern eine neue Erfahrung entgegen. So entsteht ein Weg,
          der zu dir passt, und das Vertrauen, dass du dich auf dich verlassen kannst.
        </p>
      </div>
      <div class="bremse">
        <div class="bremse__spalte" data-erscheinen>
          <h3 class="bremse__titel">Was dich bisher bremst</h3>
          <p>
            Motivation ist flüchtig. Spätestens nach den Weihnachtsferien holt uns der Alltag zurück, und die alten Gewohnheiten
            klopfen wieder an.
          </p>
          <p class="bremse__satz">„Du schaffst es ja sowieso nicht.“</p>
          <p>
            Wer sich oft etwas versprochen und es wieder gebrochen hat, nimmt die eigenen Vorhaben weniger ernst als eine
            Verabredung mit der besten Freundin.
          </p>
        </div>
        <div class="bremse__spalte bremse__spalte--hilft" data-erscheinen>
          <h3 class="bremse__titel">Was dir hier hilft</h3>
          <ol class="bremse__schritte">
            {hilft.map((schritt) => <li>{schritt}</li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Drei mögliche Leben · Methode -->
  <section class="abschnitt" aria-labelledby="leben-titel">
    <div class="container">
      <div class="kopfblock">
        <p class="label">03 · Drei mögliche Leben</p>
        <h2 id="leben-titel" class="zeile">Drei <span class="pivot">mögliche</span> Leben</h2>
        <p class="einleitung text">Du entwirfst drei völlig unterschiedliche Versionen deines Zukunfts-Ichs. Jede beantwortet eine andere Frage.</p>
      </div>
      <ul class="leben">
        {
          leben.map((l) => (
            <li class="leben__karte" data-erscheinen>
              <h3>{l.titel}</h3>
              <p>{l.frage}</p>
            </li>
          ))
        }
      </ul>
      <p class="leben__danach text">
        Danach fragst du dich, welchen dieser Menschen du in fünf Jahren am liebsten kennenlernen würdest. Diesen Entwurf testest du
        im Alltag. Dein Weg darf am Ende Teile aus allen drei Entwürfen enthalten.
      </p>
    </div>
  </section>

  <!-- 5. Ein Programm, zwei Module · Methode -->
  <section class="abschnitt" id="programme" aria-labelledby="programme-titel">
    <div class="container">
      <div class="kopfblock">
        <p class="label">04 · Ein Programm, zwei Module</p>
        <h2 id="programme-titel" class="zeile">Erst entwerfen, dann <span class="pivot">verwirklichen</span></h2>
        <p class="einleitung text">Meine Methode führt dich in sieben Phasen von deinem heutigen Leben zu deinem eigenen Weg.</p>
      </div>

      <Treppe />

      <p class="programme__hinweis text">
        „Entwirf dein Zukunfts-Ich“ führt dich durch die Phasen 1 bis 6. „Manifestiere dein Zukunfts-Ich“ vertieft Phase 7 und ist in
        Vorbereitung.{' '}
        <a href={seiten.wieIchArbeite}>Mehr dazu, wie ich arbeite</a>
      </p>

      <div class="module">
        <ModulKarte
          label="Modul 1 · verfügbar"
          titel="Entwirf dein"
          pivot="Zukunfts-Ich"
          zeilen={[
            {
              label: 'Für dich, wenn',
              text: 'du spürst, dass sich etwas verändern soll, aber noch nicht genau sagen kannst, was es ist und wie dein erster Schritt aussehen könnte.',
            },
            {
              label: 'Am Ende',
              text: 'weißt du, worauf du gewartet hast und welche Muster dich zurückhalten. Du hast drei mögliche Leben entworfen, deine Werte daraus abgeleitet, eine Richtung gewählt und sie 14 Tage lang im Alltag erprobt.',
            },
            {
              label: 'So arbeitest du',
              text: 'allein mit dem Kursbuch, oder wir gehen den Weg gemeinsam, in der Gruppe oder zu zweit. Der Kurs hat neun Einheiten und braucht rund 10 Stunden, verteilt über bis zu 6 Wochen.',
            },
          ]}
          link={{ href: seiten.modul1, label: 'Mehr zu Modul 1' }}
        />
        <ModulKarte
          label="Modul 2 · in Vorbereitung"
          titel="Manifestiere dein"
          pivot="Zukunfts-Ich"
          inVorbereitung
          zeilen={[
            { label: 'Für dich, wenn', text: 'du deine Richtung kennst und sie zu einem festen Teil deines Lebens machen möchtest.' },
            {
              label: 'Darin',
              text: 'baust du deine Richtung im Einzelnen aus, prüfst deine Annahmen und übersetzt deinen Weg in 90 Tage mit Meilensteinen und neuen Gewohnheiten.',
            },
            {
              label: 'Einstieg',
              text: 'Das Kursbuch ist einzeln erhältlich, sobald es erscheint. Persönliche Begleitung beginnt mit einem Orientierungsgespräch, in dem wir klären, ob Modul 1 vorher sinnvoll ist.',
            },
          ]}
          link={{ href: '#liste', label: 'Benachrichtige mich zum Start' }}
        />
      </div>
    </div>
  </section>

  <!-- 6. Wer dich begleitet · Vertrauen -->
  <section class="abschnitt" id="ueber" aria-labelledby="ueber-titel">
    <div class="container ueber">
      <div class="ueber__text">
        <div class="kopfblock">
          <p class="label">05 · Über mich</p>
          <h2 id="ueber-titel" class="zeile">Wer dich <span class="pivot">begleitet</span></h2>
        </div>
        <p class="einleitung" data-erscheinen>
          Ich bin Christine Achmus, Mentorin für Lebensentwürfe. Ich habe Bildungswissenschaften mit Schwerpunkt Pädagogische
          Psychologie studiert und bringe aus dem Projektmanagement viel Erfahrung mit Veränderungsprozessen mit. Meine Methode habe
          ich zuerst an mir selbst ausprobiert. Daraus ist Life&amp;Lemons entstanden.
        </p>
        <a class="textlink" href={seiten.ueberMich}>Mehr über mich <span aria-hidden="true">→</span></a>
      </div>
      <div class="ueber__foto">
        <Polaroid bild={zweitesFoto} alt="Christine Achmus vor einer terrakottafarbenen Wand" name="Christine" bildposition="50% 30%" />
      </div>
    </div>
  </section>

  {
    stimmenZeigen && (
      <section class="abschnitt" aria-labelledby="stimmen-titel">
        <div class="container">
          <div class="kopfblock">
            <p class="label">Stimmen</p>
            <h2 id="stimmen-titel">
              Erfahrungen aus der <span class="pivot">ersten</span> Gruppe
            </h2>
          </div>
          {/* Hier zwei bis drei echte Stimmen mit schriftlicher Einwilligung einfügen */}
        </div>
      </section>
    )
  }

  <!-- 7. Welcher Weg weckt dein Interesse? · Entscheidung (mit Kursbuch) -->
  <section class="abschnitt" id="kursbuch" aria-labelledby="einstieg-titel">
    <div class="container">
      <div class="kopfblock">
        <p class="label">06 · Dein Einstieg</p>
        <h2 id="einstieg-titel" class="zeile">Welcher Weg weckt dein <span class="pivot">Interesse</span>?</h2>
        <p class="einleitung text">Alle Wege führen durch dieselbe Methode. Du entscheidest, wie viel Begleitung du dir wünschst.</p>
      </div>

      <div class="dunkel kursbuch__innen">
        <div class="kursbuch__bild" data-erscheinen>
          <Image
            src={kursbuchFoto}
            alt="Das Kursbuch Entwirf dein Zukunfts-Ich mit Vorder- und Rückseite auf einem hellen Leinentuch"
            widths={[420, 640, 900]}
            sizes="(max-width: 860px) 92vw, 40vw"
            format="webp"
            quality={80}
          />
        </div>
        <div class="kursbuch__text">
          <p class="label">Allein mit dem Kursbuch</p>
          <h3 class="kursbuch__titel">Entwirf dein <span class="pivot">Zukunfts-Ich</span></h3>
          <p>
            Du arbeitest in deinem eigenen Tempo. Das Kursbuch verfügt über 184 Seiten, mit viel Platz für deine Erkenntnisse und
            Notizen. Es führt dich ganz intuitiv durch jede Übung, ohne dass du lange Texte verfassen musst. Zwischen den neun
            Einheiten gehst du erste Schritte im echten Leben, und zum Schluss probierst du deine neue Richtung 14 Tage lang im
            Alltag aus.
          </p>
          <Preis id="kursbuch" />
          {kursbuch.lieferhinweis && <p class="kursbuch__liefer">{kursbuch.lieferhinweis}</p>}
          <div class="aktionen">
            <AngebotButton id="kursbuch" variante="hell" />
          </div>
          {kursbuchHinweis && <p class="kursbuch__hinweis">{kursbuchHinweis}</p>}
        </div>
      </div>

      <div class="wege">
        <article class="wege__karte" data-erscheinen>
          <p class="label">Begleitet</p>
          <p>In einer kleinen Gruppe in Hannover oder einzeln mit mir, vor Ort oder online.</p>
          <a class="textlink" href={`${seiten.modul1}#formate`}>Club und Einzel-Track <span aria-hidden="true">→</span></a>
        </article>
        <article class="wege__karte" data-erscheinen>
          <p class="label">Intensiv im 1:1</p>
          <p>Wir übertragen jede Erkenntnis direkt auf deine Lebenssituation.</p>
          <a class="textlink" href={`${seiten.modul1}#formate`}>VIP-Track <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- 8. Interessentenliste · Danach -->
  <Interessentenliste
    label="07 · Was als Nächstes startet"
    titel="Ich melde mich, sobald es"
    pivot="losgeht"
    text="Ich schreibe dir nur, wenn etwas startet, das du ausgewählt hast. Abmelden kannst du dich jederzeit."
  />
</Base>

<style>
  /* Erster Bildschirm */
  .hero {
    padding: clamp(40px, 6vw, 88px) 0 0;
    overflow: hidden;
  }

  .hero__innen {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: clamp(32px, 5vw, 80px);
  }

  .hero__text {
    flex: 1 1 520px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: clamp(40px, 6vw, 96px);
    min-width: 0;
  }

  .hero__text .einleitung {
    max-width: 34rem;
  }

  .hero__text .aktionen {
    margin-top: 8px;
  }

  .hero__bild {
    position: relative;
    flex: 1 1 380px;
    max-width: 560px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-left: auto;
    margin-bottom: clamp(40px, 6vw, 96px);
    background: var(--leinen);
  }

  /* Hauptfoto füllt den Rahmen; der Ausschnitt hält das Gesicht im oberen Drittel */
  .hero__bild :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
  }

  @media (max-width: 860px) {
    .hero__bild {
      margin: 0 auto clamp(40px, 6vw, 96px);
      max-width: 460px;
      width: 100%;
    }
  }

  /* „Neu“-Hinweis */
  .neu {
    display: inline-flex;
    align-items: baseline;
    gap: 14px;
    align-self: flex-start;
    margin-top: 12px;
    padding: 14px 20px 14px 18px;
    background: var(--papier-hell);
    border-left: 2px solid var(--terrakotta);
    color: var(--tinte);
    text-decoration: none;
    font-size: 15px;
    line-height: 1.45;
    transition: background-color 300ms var(--kurve);
  }

  .neu:hover,
  .neu:focus-visible {
    background: #fdfcf9;
    color: var(--tinte);
  }

  .neu__label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--terrakotta-tief);
  }

  .neu__text {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 250ms var(--kurve);
  }

  .neu:hover .neu__text {
    text-decoration-color: var(--terrakotta);
  }

  /* Fragen */
  .fragen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 0 clamp(32px, 5vw, 72px);
  }

  .fragen li {
    border-top: 1px solid var(--linie);
    padding: 28px 0 32px;
  }

  .fragen blockquote {
    margin: 0;
  }

  .fragen p {
    font-family: var(--schrift-titel);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(24px, 2.3vw, 30px);
    line-height: 1.25;
  }

  .fragen__auf {
    color: var(--terrakotta-tief);
  }

  /* Module */
  .module {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin-top: clamp(48px, 6vw, 88px);
  }

  /* Kursbuch */
  .kursbuch__innen {
    padding: clamp(28px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .kursbuch__bild {
    flex: 1 1 340px;
    max-width: 480px;
    min-height: 320px;
  }

  .kursbuch__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kursbuch__text {
    flex: 1 1 440px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }


  .kursbuch__liefer {
    font-weight: 700;
    margin-top: -8px;
  }

  .kursbuch__hinweis {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--leinen);
    max-width: 46ch;
  }

  .kursbuch__hinweis a {
    color: var(--kalk);
    text-decoration-color: var(--terrakotta-hell);
  }

  .kursbuch__hinweis a:hover {
    color: var(--terrakotta-hell);
  }

  /* Was bremst, was hilft */
  .bremse {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(28px, 4vw, 64px);
  }

  .bremse__spalte {
    border-top: 2px solid var(--tinte);
    padding-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: var(--breite-text);
  }

  .bremse__spalte--hilft {
    border-top-color: var(--terrakotta);
  }

  .bremse__titel {
    font-family: var(--schrift-text);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--terrakotta-tief);
    margin: 0;
  }

  .bremse__satz {
    font-family: var(--schrift-titel);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(24px, 2.3vw, 30px);
    line-height: 1.25;
  }

  .bremse__schritte {
    list-style: none;
    counter-reset: schritt;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .bremse__schritte li {
    counter-increment: schritt;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
  }

  .bremse__schritte li::before {
    content: counter(schritt, decimal-leading-zero);
    font-family: var(--schrift-titel);
    font-size: 22px;
    line-height: 1.2;
    color: var(--terrakotta);
  }

  /* Drei mögliche Leben */
  .leben {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(20px, 2.5vw, 32px);
  }

  .leben__karte {
    border: 1px solid var(--linie);
    border-top: 2px solid var(--terrakotta);
    padding: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: background-color 300ms var(--kurve);
  }

  .leben__karte:hover {
    background: var(--papier-hell);
  }

  .leben__karte h3 {
    font-size: clamp(32px, 3vw, 42px);
    line-height: 1;
    margin: 0;
  }

  .leben__karte p {
    font-size: 17px;
    line-height: 1.55;
  }

