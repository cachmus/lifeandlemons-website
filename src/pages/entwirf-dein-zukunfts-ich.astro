---
import Base from '../layouts/Base.astro';
import Platzhalter from '../components/Platzhalter.astro';
---

<Base
  title="Programm „Entwirf dein Zukunfts-Ich“"
  description="Wie das Programm „Entwirf dein Zukunfts-Ich“ aufgebaut ist: neun Einheiten, drei mögliche Zukunftsentwürfe und ein Test im echten Leben."
>
  <section class="section">
    <div class="container text">
      <h1>Entwirf dein Zukunfts-Ich</h1>
      <Platzhalter quelle="Broschüre V14, S. 2 und 3">
        <p>Einleitung: für wen das Programm ist und welches Problem es bearbeitet.</p>
      </Platzhalter>
    </div>
  </section>

  <section class="section section--flaeche">
    <div class="container text">
      <h2>Warum Warten auch einen Preis hat</h2>
      <Platzhalter quelle="Broschüre V14, S. 3 und 5">
        <p>Rechnung des Wartens, erwünschtes und befürchtetes Zukunftsbild, innere Bremse.</p>
      </Platzhalter>
    </div>
  </section>

  <section class="section">
    <div class="container text">
      <h2>So arbeitet das Programm</h2>
      <Platzhalter quelle="Broschüre V14, S. 4">
        <p>Die drei Teile des Kurses und die neun Einheiten, Lebens-Interview und 14 Tage Probezeit.</p>
      </Platzhalter>
    </div>
  </section>

  <section class="section section--flaeche">
    <div class="container text">
      <h2>Ein Beispiel</h2>
      <Platzhalter quelle="Broschüre V14, Beispiel Verena">
        <p>Das Beispiel von Verena.</p>
      </Platzhalter>
    </div>
  </section>

  <section class="section">
    <div class="container text">
      <h2>Was das Programm nicht ist</h2>
      <Platzhalter quelle="Broschüre V14, S. 6">
        <p>Klare Grenzen des Kurses, keine Therapie.</p>
      </Platzhalter>
      <a class="button" href="/angebote/">Den passenden Weg finden</a>
    </div>
  </section>
</Base>
