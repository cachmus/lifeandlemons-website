---
/**
 * Impressum. ENTWURF, fachlich zu prüfen (nur hier im Code vermerkt, nicht auf der Seite): vor dem Livegang von einer Fachperson prüfen lassen.
 * Stand der Angaben: 19.10.2026, Geschäftsbezeichnung 27.10.2026 (Christine).
 * - Anschrift: Privatadresse, bewusst gewählt (zentral in src/config/site.ts)
 * - Telefonnummer seit 18.11.2026 (Christine), weil Digistore24 sie für die Produktfreigabe verlangt; dazu Instagram
 * - Stand 16.11.2026 (Christine): gewerbliche Tätigkeit (Verkauf von Produkten steht im Vordergrund), Kleinunternehmerregelung
 *   nach § 19 UStG. Noch keine USt-IdNr. und keine Wirtschafts-Identifikationsnummer. Eine Steuernummer gehört nicht ins
 *   Impressum. Sobald eine USt-IdNr. oder W-IdNr. vergeben ist, muss sie hier ergänzt werden (§ 5 Abs. 1 Nr. 6 DDG).
 * - Die EU-Plattform zur Online-Streitbeilegung ist seit 20.07.2025 abgeschaltet, deshalb kein Link darauf.
 */
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---

<Base title="Impressum und Kontakt" description={`Impressum von ${site.firmierung}.`}>
  <section class="abschnitt recht">
    <div class="container text fliesstext">
      <p class="label">Rechtliches</p>
      <h1>Impressum</h1>

      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        {site.firmierung}<br />
        Inhaberin: {site.inhaberin}<br />
        {site.anschrift.strasse}<br />
        {site.anschrift.plzOrt}
      </p>

      <h2>Kontakt</h2>
      <p>
        Telefon: <a href={`tel:${site.telefon.wahl}`}>{site.telefon.anzeige}</a><br />
        E-Mail: <a href={`mailto:${site.kontaktEmail}`}>{site.kontaktEmail}</a><br />
        Instagram: <a href={site.instagram.url} rel="noopener">{site.instagram.handle}</a>
      </p>

      <h2>Umsatzsteuer</h2>
      <p>Kleinunternehmerin im Sinne von § 19 UStG. Es wird keine Umsatzsteuer ausgewiesen.</p>

      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>{site.inhaberin}, Anschrift wie oben</p>

      <h2>Verbraucherstreitbeilegung</h2>
      <p>
        Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle
        teilzunehmen.
      </p>
    </div>
  </section>
</Base>

<style>
  .recht h1 {
    font-size: clamp(44px, 6vw, 72px);
    margin-bottom: 0.4em;
  }
  .recht h2 {
    font-size: clamp(26px, 2.6vw, 34px);
    margin-top: 1.6em;
  }
</style>
