---
import Base from '../layouts/Base.astro';
import AngebotKarte from '../components/AngebotKarte.astro';
import Platzhalter from '../components/Platzhalter.astro';
import { angebote, einfuehrungAktiv, formatDatum, EINFUEHRUNG_BIS } from '../config/angebote';
import { anfrageLink } from '../config/site';

const sichtbar = angebote.filter((a) => a.sichtbar);
---

<Base
  title="Angebote"
  description="Kursbuch, Einzel-Track, Life&Lemons Club und VIP-Track: die Wege durch „Entwirf dein Zukunfts-Ich“ mit Preisen, Plätzen und Terminen."
>
  <section class="section">
    <div class="container">
      <div class="text">
        <h1>Angebote</h1>
        {
          einfuehrungAktiv() && (
            <p>Bis {formatDatum(EINFUEHRUNG_BIS)} gelten Einführungspreise.</p>
          )
        }
        <Platzhalter quelle="Broschüre V14, S. 7">
          <p>Kurze Orientierung: Die Wege unterscheiden sich darin, wie selbstständig du arbeitest und wie viel persönliche Begleitung du bekommst.</p>
          <p>OFFEN: Preishinweis (inkl. MwSt. oder Kleinunternehmerregelung) ergänzen.</p>
        </Platzhalter>
      </div>

      <div class="raster">
        {sichtbar.map((angebot) => <AngebotKarte angebot={angebot} />)}
      </div>

      <div class="text orientierung">
        <h2>Unsicher, welcher Weg passt?</h2>
        <p>In einem 15-minütigen Orientierungsgespräch am Telefon klären wir, welcher Weg zu dir passt.</p>
        <a class="button" href={anfrageLink('Orientierungsgespräch')}>Orientierungsgespräch anfragen</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .raster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--abstand-m);
    margin: var(--abstand-l) 0;
  }
  .orientierung {
    margin-top: var(--abstand-xl);
  }
</style>
