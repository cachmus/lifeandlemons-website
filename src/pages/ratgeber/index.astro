---
/**
 * Ratgeber-Übersicht als Magazin, Richtung B „Abendlicht“ (Neugestaltung, entschieden 16.11.2026).
 * Artikel nach Themen, aus src/ratgeber/*.md (Konfiguration src/config/ratgeber.ts).
 * Aufbau: Kopf mit Bild, neuester Artikel groß, Rubriken mit Motiv, weitere Artikel, Try a Life, Journal (Try a Life zuerst, Christine, 19.11.2026).
 * Wortlaut: Entwurf vom 16.11.2026, Freigabe durch Christine offen.
 * Rubriken mit Artikeln führen seit 27.11.2026 auf ihre Übersicht /ratgeber/thema/<id>/ (Christine).
 */
import '../../styles/magazin.css';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import JournalKarte from '../../components/JournalKarte.astro';
import TryALifeKarte from '../../components/TryALifeKarte.astro';
import { site } from '../../config/site';
import { themen, artikel, artikelPfad, themaPfad, aufmacher } from '../../config/ratgeber';
import kopfBild from '../../assets/ratgeber/magazin-kopf.jpg';
import portraet from '../../assets/portraet-christine-aquarell.jpg';

const neuester = artikel[0];
const neuesterBild = neuester ? aufmacher[neuester.slug] : undefined;
const neuesterThema = neuester ? themen.find((t) => t.id === neuester.thema) : undefined;
const weitere = artikel.slice(1);
const rubriken = themen.map((t) => ({ ...t, anzahl: artikel.filter((a) => a.thema === t.id).length }));
const datum = (d: string) => new Date(d).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Ratgeber für Fragen, die dich beschäftigen"
  seite={{ typ: 'CollectionPage' }}
  description="Artikel mit Übungen für deinen Jahresrückblick, für mehr Orientierung und für Lebensziele, die im Alltag halten. Von Christine Achmus, Life&Lemons."
  dunklerSchluss
>
  <div class="magazin">
    <section class="mkopf" aria-labelledby="ratgeber-titel">
      <div class="container mkopf__raster">
        <div class="mkopf__text">
          <p class="m-kennzeile">Der Ratgeber von Life&amp;Lemons</p>
          <h1 id="ratgeber-titel" class="m-titel mkopf__titel">Für die Fragen, die dich gerade wirklich <em>beschäftigen</em></h1>
          <p class="mkopf__einleitung m-gedaempft">
            Was will ich eigentlich? Und warum halten meine Vorhaben im Alltag so selten lange? Hier schreibe ich über genau solche Fragen,
            mit Übungen, die du sofort ausprobieren kannst.
          </p>
          <p class="mkopf__von">
            <Image class="mkopf__portraet" src={portraet} alt="Christine Achmus als Aquarell-Porträt" widths={[64, 128]} sizes="56px" />
            <span>Von {site.inhaberin}, {site.rolle}</span>
          </p>
        </div>
        <div class="mkopf__bild">
          <Image
            src={kopfBild}
            alt="Aquarell einer Terrasse über dem Meer im Abendlicht mit Treppe, Booten und Zitronenzweig"
            widths={[420, 640, 900]}
            sizes="(min-width: 960px) 420px, 100vw"
            loading="eager"
          />
        </div>
      </div>
    </section>

    {
      neuester && (
        <section class="neu" aria-labelledby="neu-titel">
          <div class="container">
            <p class="m-kennzeile neu__kennzeile" id="neu-titel">
              Neu im Ratgeber
            </p>
            <a class="aufmacher" href={artikelPfad(neuester.slug)}>
              {neuesterBild && (
                <span class="aufmacher__bild">
                  <Image src={neuesterBild.bild} alt={neuesterBild.alt} widths={[480, 720, 1000]} sizes="(min-width: 960px) 520px, 100vw" />
                </span>
              )}
              <span class="aufmacher__text">
                <span class="m-kennzeile">{neuesterThema?.label}</span>
                <span class="m-titel aufmacher__titel">{neuester.titel}</span>
                <span class="aufmacher__beschreibung m-gedaempft">{neuester.beschreibung}</span>
                <span class="aufmacher__meta m-gedaempft">
                  {datum(neuester.aktualisiert ?? neuester.veroeffentlicht)} · {neuester.lesezeit} Minuten Lesezeit
                </span>
                <span class="aufmacher__mehr">
                  Artikel lesen <span aria-hidden="true">→</span>
                </span>
              </span>
            </a>
          </div>
        </section>
      )
    }

    <section class="rubriken" aria-labelledby="rubriken-titel">
      <div class="container">
        <h2 id="rubriken-titel" class="m-titel rubriken__titel">Rubriken</h2>
        <ul class="rubriken__liste">
          {
            rubriken.map((r) => (
              <li>
                {r.anzahl > 0 ? (
                  <a class="rubrik rubrik--link" href={themaPfad(r.id)}>
                    <span class="rubrik__rahmen">
                      <Image class="rubrik__bild" src={r.bild} alt={r.bildAlt} widths={[320, 480]} sizes="(min-width: 960px) 360px, 100vw" />
                    </span>
                    <h3 class="m-titel rubrik__name">{r.label}</h3>
                    <p class="m-gedaempft rubrik__text">{r.beschreibung}</p>
                    <p class="rubrik__zahl">
                      {r.anzahl === 1 ? '1 Artikel' : `${r.anzahl} Artikel`} <span aria-hidden="true">→</span>
                    </p>
                  </a>
                ) : (
                  <div class="rubrik">
                    <span class="rubrik__rahmen">
                      <Image class="rubrik__bild" src={r.bild} alt={r.bildAlt} widths={[320, 480]} sizes="(min-width: 960px) 360px, 100vw" />
                    </span>
                    <h3 class="m-titel rubrik__name">{r.label}</h3>
                    <p class="m-gedaempft rubrik__text">{r.beschreibung}</p>
                    <p class="rubrik__zahl">Artikel in Vorbereitung</p>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      weitere.length > 0 && (
        <section class="alle" aria-labelledby="alle-titel">
          <div class="container">
            <h2 id="alle-titel" class="m-titel rubriken__titel">
              Weitere Artikel
            </h2>
            <ul class="alle__liste">
              {weitere.map((a) => (
                <li>
                  <a href={artikelPfad(a.slug)} class="eintrag">
                    <span class="m-kennzeile">{themen.find((t) => t.id === a.thema)?.label}</span>
                    <span class="m-titel eintrag__titel">{a.titel}</span>
                    <span class="m-gedaempft">{a.lesezeit} Minuten Lesezeit</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <section class="m-journal" aria-label="Try a Life und kostenloses Journal">
      <div class="container m-hell m-karten">
        <TryALifeKarte />
        <JournalKarte
          titel="Sanft einsteigen"
          text="Mein kostenloses Journal führt dich Schritt für Schritt durch deinen Jahresrückblick, bis zu einem ersten Schritt, der in deinen Alltag passt."
        />
      </div>
    </section>
  </div>
</Base>

<style>
  .mkopf {
    padding: clamp(40px, 7vw, 104px) 0 clamp(40px, 6vw, 80px);
    border-bottom: 1px solid var(--abend-linie);
  }

  .mkopf__raster {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  @media (min-width: 900px) {
    .mkopf__raster {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
  }

  .mkopf__text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .mkopf__titel {
    font-size: clamp(44px, 6.4vw, 88px);
  }

  .mkopf__einleitung {
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.6;
    max-width: 36rem;
    margin: 0;
  }

  .mkopf__von {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--schrift-magazin);
    font-style: italic;
    font-size: 18px;
    margin: 0;
  }

  .mkopf__portraet {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 18%;
    flex: none;
  }

  .mkopf__bild :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 70% 60%;
  }

  .neu {
    padding: clamp(48px, 7vw, 96px) 0;
  }

  .neu__kennzeile {
    margin-bottom: 24px;
  }

  .aufmacher {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 56px);
    text-decoration: none;
    color: inherit;
    align-items: center;
  }

  @media (min-width: 900px) {
    .aufmacher {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }

  .aufmacher__bild {
    display: block;
    overflow: hidden;
  }

  .aufmacher__bild :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 600ms var(--kurve);
  }

  .aufmacher:hover .aufmacher__bild :global(img) {
    transform: scale(1.03);
  }

  .aufmacher__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .aufmacher__titel {
    font-size: clamp(32px, 3.8vw, 52px);
  }

  .aufmacher__beschreibung {
    font-size: 18px;
    line-height: 1.6;
  }

  .aufmacher__meta {
    font-size: 14px;
  }

  .aufmacher__mehr {
    font-weight: 700;
    color: var(--abend-akzent);
    border-bottom: 1px solid currentColor;
    align-self: flex-start;
    padding-bottom: 2px;
  }

  .rubriken,
  .alle {
    padding: clamp(48px, 7vw, 96px) 0;
    border-top: 1px solid var(--abend-linie);
  }

  .rubriken__titel {
    font-size: clamp(32px, 3.6vw, 48px);
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .rubriken__liste,
  .alle__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(28px, 3vw, 44px);
  }

  .rubrik {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rubrik--link {
    text-decoration: none;
    color: inherit;
  }

  .rubrik__rahmen {
    display: block;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .rubrik__bild {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--lesen-grund);
    transition: transform 600ms var(--kurve);
  }

  .rubrik--link:hover .rubrik__bild {
    transform: scale(1.03);
  }

  .rubrik__name {
    font-size: clamp(24px, 2.2vw, 30px);
  }

  .rubrik__text {
    font-size: 16px;
    line-height: 1.55;
    margin: 0;
  }

  .rubrik__zahl {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--abend-akzent);
    margin: 0;
  }

  /* Wie „Artikel lesen“ beim Aufmacher: unterstrichen, damit die Rubrik als Link erkennbar ist */
  .rubrik--link .rubrik__zahl {
    font-weight: 700;
    align-self: flex-start;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .eintrag {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    padding-top: 18px;
    border-top: 1px solid var(--abend-linie);
  }

  .eintrag__titel {
    font-size: clamp(24px, 2.4vw, 32px);
  }

  .m-karten {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 4vw, 40px);
  }

  .m-journal {
    padding: clamp(48px, 7vw, 96px) 0 clamp(64px, 8vw, 112px);
    border-top: 1px solid var(--abend-linie);
  }
</style>
