---
/**
 * Ratgeberartikel. Inhalte aus src/ratgeber/<slug>.md (Frontmatter siehe src/config/ratgeber.ts).
 * Aufbau: Brotkrumen, Titel, „Kurz gesagt“, Inhaltsverzeichnis, Text, Journal-Karte, Autorin, Fragen und Antworten, weitere Artikel.
 * Gestaltung als Magazin, Richtung B „Abendlicht“ (16.11.2026): dunkler Kopf mit Aufmacher, Text auf heller Lesefläche.
 */
import '../../styles/magazin.css';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import JournalKarte from '../../components/JournalKarte.astro';
import Polaroid from '../../components/Polaroid.astro';
import { site, seiten } from '../../config/site';
import { artikelModule, artikel, artikelPfad, themen, aufmacher } from '../../config/ratgeber';
import { artikelDaten } from '../../config/strukturierteDaten';
import portraet from '../../assets/portraet-christine-4x5.jpg';

export function getStaticPaths() {
  return artikelModule.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const eintrag = artikelModule.find((m) => m.slug === slug)!;
const a = artikel.find((x) => x.slug === slug)!;
const Inhalt = eintrag.modul.Content as any;
const kapitel = eintrag.modul.getHeadings().filter((h) => h.depth === 2);
const thema = themen.find((t) => t.id === a.thema)!;
const weitere = artikel.filter((x) => x.slug !== slug && x.thema === a.thema).slice(0, 3);
const datum = new Date(a.aktualisiert ?? a.veroeffentlicht).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
const pfad = artikelPfad(slug!);
const bild = aufmacher[slug!];
---

<Base
  title={a.titel}
  description={a.beschreibung}
  ogTyp="article"
  dunklerSchluss
  daten={artikelDaten({ titel: a.titel, beschreibung: a.beschreibung, pfad, veroeffentlicht: a.veroeffentlicht, aktualisiert: a.aktualisiert, faq: a.faq })}
>
  <article class="artikel magazin">
    <header class="akopf">
      <div class="container akopf__raster">
        <div class="akopf__text">
          <nav class="krumen" aria-label="Brotkrumen">
            <a href={seiten.ratgeber}>Ratgeber</a>
            <span aria-hidden="true">/</span>
            <span>{thema.label}</span>
          </nav>
          <h1 class="m-titel akopf__titel">{a.titel}</h1>
          <p class="akopf__beschreibung m-gedaempft">{a.beschreibung}</p>
          <p class="akopf__meta m-gedaempft">
            Von <a href={seiten.ueberMich}>{site.inhaberin}</a>{` · ${a.aktualisiert ? 'Aktualisiert' : 'Veröffentlicht'} am ${datum} · ${a.lesezeit} Minuten Lesezeit`}
          </p>
        </div>
        {
          bild && (
            <div class="akopf__bild">
              <Image src={bild.bild} alt={bild.alt} widths={[420, 640, 1000]} sizes="(min-width: 960px) 440px, 100vw" loading="eager" />
            </div>
          )
        }
      </div>
    </header>

    <div class="lesen">
    <div class="container artikel__raster">
      <aside class="inhalt" aria-label="Inhalt dieses Artikels">
        <p class="inhalt__titel">Inhalt</p>
        <ol>
          {
            kapitel.map((k) => (
              <li>
                <a href={`#${k.slug}`}>{k.text}</a>
              </li>
            ))
          }
          {a.faq?.length && <li><a href="#fragen">Häufige Fragen</a></li>}
        </ol>
      </aside>

      <div class="artikel__haupt">
        <div class="kurz">
          <p class="kurz__titel">Kurz gesagt</p>
          <ul>{a.kurz.map((k) => <li>{k}</li>)}</ul>
        </div>

        <div class="prosa">
          <Inhalt />
        </div>

        <div class="artikel__journal m-hell">
          <JournalKarte
            variante="kompakt"
            ueberschriftEbene="h2"
            titel="Alle Fragen in einem Journal"
            text="Du willst die Fragen nicht abschreiben? Mein kostenloses Journal „Wer will ich in 12 Monaten sein?“ führt dich durch Rückblick, Who-to-be-Liste und deinen ersten Schritt."
          />
        </div>

        <div class="autorin">
          <div class="autorin__foto">
            <Polaroid bild={portraet} alt="Christine Achmus" name="Christine" bildposition="50% 20%" />
          </div>
          <div>
            <p class="label">Über die Autorin</p>
            <p>
              Ich bin Christine Achmus, {site.rolle} und Gründerin von Life&amp;Lemons. Ich habe Bildungswissenschaften mit Schwerpunkt
              Pädagogische Psychologie studiert. Die Übungen, über die ich schreibe, stützen sich auf psychologische Forschung, und ich habe
              sie zuerst an mir selbst ausprobiert.
            </p>
            <a class="textlink" href={seiten.ueberMich}>Mehr über mich</a>
          </div>
        </div>

        {
          a.faq?.length && (
            <section class="fragen" id="fragen" aria-labelledby="fragen-titel">
              <h2 id="fragen-titel">Häufige Fragen</h2>
              {a.faq.map((f) => (
                <details>
                  <summary>{f.frage}</summary>
                  <p>{f.antwort}</p>
                </details>
              ))}
            </section>
          )
        }

        <p class="hinweis gedaempft">
          Dieser Artikel dient der Selbstreflexion und ersetzt keine Psychotherapie oder medizinische Behandlung.
        </p>
      </div>
    </div>
    </div>

    <nav class="aende" aria-label="Weiterlesen im Ratgeber">
      <div class="container aende__innen">
        <p class="m-kennzeile">Weiterlesen</p>
        {
          weitere.length > 0 && (
            <ul class="aende__liste">
              {weitere.map((w) => (
                <li>
                  <a class="m-titel" href={artikelPfad(w.slug)}>{w.kurztitel}</a>
                </li>
              ))}
            </ul>
          )
        }
        <a class="aende__alle" href={seiten.ratgeber}>Alle Artikel im Ratgeber <span aria-hidden="true">→</span></a>
      </div>
    </nav>
  </article>
</Base>

<style>
  .akopf {
    padding: clamp(32px, 6vw, 88px) 0 clamp(40px, 6vw, 80px);
  }

  .akopf__raster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  @media (min-width: 900px) {
    .akopf__raster {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }

  .akopf__text {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .akopf__titel {
    font-size: clamp(38px, 5.2vw, 72px);
    max-width: 18ch;
  }

  .akopf__beschreibung {
    font-family: var(--schrift-magazin);
    font-style: italic;
    font-size: clamp(19px, 1.8vw, 23px);
    line-height: 1.5;
    max-width: 34rem;
    margin: 0;
  }

  .akopf__meta {
    font-size: 14.5px;
    margin: 0;
  }

  .akopf__meta a {
    color: var(--abend-akzent);
    font-weight: 700;
  }

  .akopf__bild :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .krumen {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--abend-gedaempft);
  }

  .krumen a {
    color: var(--abend-akzent);
    font-weight: 700;
  }

  .lesen {
    background: var(--lesen-grund);
    color: var(--tinte);
    padding-top: clamp(40px, 6vw, 88px);
  }

  .aende {
    padding: clamp(48px, 7vw, 96px) 0 clamp(64px, 8vw, 112px);
  }

  .aende__innen {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .aende__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .aende__liste a {
    font-size: clamp(26px, 3vw, 38px);
    text-decoration: none;
    color: inherit;
  }

  .aende__alle {
    font-weight: 700;
    color: var(--abend-akzent) !important;
    align-self: flex-start;
    border-bottom: 1px solid currentColor;
  }

  .artikel__raster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    padding-bottom: var(--abschnitt);
  }

  @media (min-width: 1040px) {
    .artikel__raster {
      grid-template-columns: 240px minmax(0, var(--breite-text));
    }
    .inhalt {
      position: sticky;
      top: 104px;
      align-self: start;
    }
  }

  .inhalt {
    font-size: 15px;
    border-left: 2px solid var(--lesen-linie);
    padding-left: 18px;
  }

  .inhalt__titel {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terrakotta-tief);
    margin-bottom: 10px;
  }

  .inhalt ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .inhalt a {
    color: var(--tinte);
    text-decoration: none;
  }

  .inhalt a:hover,
  .inhalt a:focus-visible {
    color: var(--terrakotta-tief);
    text-decoration: underline;
  }

  .artikel__haupt {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 48px);
    min-width: 0;
  }

  .kurz {
    background: #f1e8da;
    border-left: 3px solid var(--terrakotta);
    padding: clamp(20px, 3vw, 28px);
  }

  .kurz__titel {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terrakotta-tief);
    margin-bottom: 12px;
  }

  .kurz ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prosa {
    font-family: var(--schrift-magazin);
    font-size: clamp(19px, 1.5vw, 21px);
    line-height: 1.68;
  }

  .prosa > :global(p:first-of-type::first-letter) {
    float: left;
    font-size: 4.2em;
    line-height: 0.82;
    padding: 0.06em 0.1em 0 0;
    color: var(--terrakotta-tief);
  }

  .prosa :global(h2) {
    font-family: var(--schrift-magazin);
    font-weight: 500;
    font-size: clamp(28px, 2.8vw, 38px);
    line-height: 1.15;
    margin: 1.8em 0 0.6em;
    scroll-margin-top: 110px;
  }

  .prosa :global(h3) {
    font-family: var(--schrift-magazin);
    font-weight: 500;
  }

  .prosa :global(p) {
    margin: 0 0 1em;
  }

  .prosa :global(strong) {
    color: var(--tinte);
  }

  .autorin {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    padding-top: 32px;
    border-top: 1px solid var(--linie);
  }

  @media (min-width: 640px) {
    .autorin {
      grid-template-columns: 170px minmax(0, 1fr);
    }
  }

  .autorin__foto {
    max-width: 170px;
  }

  .autorin p + p {
    margin-top: 8px;
  }

  .fragen h2 {
    margin-bottom: 16px;
  }

  .fragen details {
    border-top: 1px solid var(--linie);
    padding: 16px 0;
  }

  .fragen details:last-child {
    border-bottom: 1px solid var(--linie);
  }

  .fragen summary {
    cursor: pointer;
    font-weight: 700;
    list-style-position: outside;
  }

  .fragen details p {
    margin-top: 10px;
  }

  .hinweis {
    font-size: 14px;
  }
</style>
