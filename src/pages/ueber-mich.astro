---
/**
 * Über mich: persönliches Vertrauen über den eigenen Weg mit der Methode und belegte Kompetenz.
 * Texte: Positionierungspapier V4 (30.10.2026), § 17 „Über mich“; davor claude/Texte_Unterseiten.md.
 * Regel: Elternzeit, frühere Stelle und Arbeitgeber erscheinen nicht auf der Website (bestätigt 30.10.2026).
 * Der Glaubenssatz in „Meine innere Bremse entdeckt“ steht seit 30.10.2026 bewusst auf der Seite.
 */
import Base from '../layouts/Base.astro';
import Polaroid from '../components/Polaroid.astro';
import { site, seiten } from '../config/site';
import zweitesFoto from '../assets/portraet-christine-4x5.jpg';

const weg = [
  {
    titel: 'Meine innere Bremse entdeckt',
    text: [
      'Als ich meinen eigenen Kurs zum ersten Mal durchlaufen habe, bin ich auf einen Satz gestoßen, der mich lange begleitet hat: „Mir fehlt die innere Reife, um Verantwortung für mich und meine Entscheidungen zu tragen.“ Ich habe gemerkt, wie viele Gegenbeweise mein Alltag längst liefert. Seitdem verliert der Satz an Kraft.',
    ],
  },
  {
    titel: 'Eine Richtung herausgearbeitet',
    text: [
      'Aus drei Lebensentwürfen habe ich meine Richtung und meine Werte abgeleitet. In meiner Probezeit habe ich sie 14 Tage lang im Alltag getestet, mit früheren Schlafenszeiten und einer Morgenroutine mit kleinen Workouts. Die Verbindlichkeit mir selbst gegenüber hat mir geholfen, diese Gewohnheiten viel schneller aufzubauen als früher.',
    ],
  },
  {
    titel: 'Meine Arbeit sichtbar gemacht',
    text: [
      'Mich vor die Kamera zu stellen, ist mir lange schwergefallen. Heute zeige ich meine Arbeit auf Instagram, auch an Tagen, an denen ich zweifle, und gerade entsteht meine erste Videoreihe.',
    ],
  },
];
---

<Base
  dunklerSchluss
  title="Über mich"
  description={`${site.inhaberin}, ${site.rolle}: mein eigener Weg mit der Methode und was ich in die Begleitung mitbringe.`}
>
  <section class="kopf-abschnitt">
    <div class="container zwei-spalten kopf-abschnitt__innen">
      <div class="kopf-abschnitt__text">
        <p class="label">Über mich</p>
        <h1>Christine Achmus</h1>
        <p class="unterzeile">Mentorin für Lebensentwürfe</p>
        <div class="fliesstext einleitung">
          <p>
            Ich bin Mentorin für Lebensentwürfe. Ich begleite Menschen dabei, ihr Leben bewusst zu entwerfen und neue Richtungen im
            Alltag auszuprobieren. Den Wunsch, andere mit Mentoring, Coaching und Beratung zu unterstützen, trage ich seit dem Studium in
            mir.
          </p>
          <p>
            Ich nehme deine Fragen ernst und arbeite mit einem klaren Vorgehen. Wie dein Leben aussehen soll, entscheidest du.
          </p>
        </div>
      </div>
      <div class="kopf-abschnitt__foto">
        <Polaroid bild={zweitesFoto} alt="Christine Achmus vor einer terrakottafarbenen Wand" name="Christine" bildposition="50% 30%" />
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="weg-titel">
    <div class="container">
      <div class="kopfblock">
        <p class="label">01 · Mein Weg</p>
        <h2 id="weg-titel" class="zeile">Mein Weg mit der <span class="pivot">Methode</span></h2>
        <p class="einleitung text">So weit hat mich die Arbeit mit meinem Zukunfts-Ich gebracht.</p>
      </div>
      <ol class="weg">
        {
          weg.map((schritt, i) => (
            <li class="weg__schritt" data-erscheinen>
              <p class="weg__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="weg__titel">{schritt.titel}</h3>
              <div class="fliesstext">
                {schritt.text.map((absatz) => <p>{absatz}</p>)}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="mitbringe-titel">
    <div class="container zwei-spalten">
      <div class="kopfblock">
        <p class="label">02 · Kompetenz</p>
        <h2 id="mitbringe-titel" class="zeile">Was ich <span class="pivot">mitbringe</span></h2>
      </div>
      <dl class="mitbringe" data-erscheinen>
        <div>
          <dt>Studium</dt>
          <dd>Master in Bildungswissenschaften mit Schwerpunkt Pädagogische Psychologie</dd>
        </div>
        <div>
          <dt>Projekte</dt>
          <dd>Aus dem Projektmanagement bringe ich Erfahrung mit großen technischen Vorhaben, vielfältigen Teams und Veränderungsprozessen mit.</dd>
        </div>
        <div>
          <dt>Gespräche</dt>
          <dd>
            Menschen öffnen sich mir oft schnell mit beruflichen oder persönlichen Fragen. Ich schaue dann ganzheitlich auf ihre Lage und
            erkläre, welche psychologischen Mechanismen dahinterstecken.
          </dd>
        </div>
        <div>
          <dt>Kursbuch</dt>
          <dd>
            Mein Kursbuch verbindet Forschung zu Zielen, Gewohnheiten und möglichen Selbst mit Methoden der Lebensgestaltung.{' '}
            <a href={`${seiten.wieIchArbeite}#grundlagen`}>Worauf meine Arbeit beruht</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="abschnitt abschnitt--ende" aria-labelledby="einstieg-titel">
    <div class="container zwei-spalten">
      <div class="kopfblock">
        <p class="label">03 · Zusammenarbeit</p>
        <h2 id="einstieg-titel" class="zeile">Finde deinen <span class="pivot">Einstieg</span></h2>
      </div>
      <div class="fliesstext text" data-erscheinen>
        <p>
          Mit dem Kursbuch arbeitest du allein. Wenn du dir Begleitung wünschst, findest du Club, Einzel-Track und VIP-Track auf der
          Seite zu Modul 1.
        </p>
        <div class="aktionen">
          <a class="button" href={`${seiten.modul1}#formate`}>Zu den Formaten <span class="button__pfeil" aria-hidden="true">→</span></a>
        </div>
        <p class="gedaempft">
          Persönliches aus meinem Alltag teile ich auf Instagram unter{' '}
          <a href={site.instagram.url} rel="noopener">{site.instagram.handle}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .kopf-abschnitt {
    padding: clamp(48px, 7vw, 112px) 0 clamp(56px, 7vw, 112px);
  }

  .kopf-abschnitt__innen {
    align-items: center;
  }

  .kopf-abschnitt__text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .kopf-abschnitt__foto {
    display: flex;
    justify-content: center;
    flex: 0 1 380px !important;
    padding-top: 24px;
  }

  .weg {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(28px, 4vw, 56px);
  }

  .weg__schritt {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 1px solid var(--linie);
    padding-top: 20px;
    font-size: 16px;
  }

  .weg__nr {
    font-family: var(--schrift-titel);
    font-size: 44px;
    line-height: 1;
    color: var(--terrakotta);
  }

  .weg__titel {
    font-size: clamp(26px, 2.4vw, 32px);
  }

  .mitbringe {
    margin: 0;
  }

  .mitbringe div {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--linie);
    font-size: 16px;
  }

  .mitbringe dt {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-gedaempft);
    padding-top: 4px;
  }

  .mitbringe dd {
    margin: 0;
  }

  @media (max-width: 520px) {
    .mitbringe div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
