---
/**
 * Foto im Polaroid-Rahmen mit Büroklammer und handschriftlichem Namen.
 * Ohne Bild erscheint eine sandfarbene Fläche als Platzhalter.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  bild?: ImageMetadata;
  alt?: string;
  name: string;
  platzhalter?: string;
  /** Bildausschnitt innerhalb des 4:5-Rahmens, z. B. „50% 20%“ */
  bildposition?: string;
}

const { bild, alt = '', name, platzhalter = 'Foto folgt', bildposition = '50% 50%' } = Astro.props;
---

<figure class="polaroid">
  <svg class="polaroid__klammer" viewBox="0 0 24 60" aria-hidden="true">
    <path d="M8 46 V10 a6 6 0 0 1 12 0 V50 a9 9 0 0 1 -18 0 V16" />
  </svg>
  <div class="polaroid__bild">
    {
      bild ? (
        <Image src={bild} alt={alt} widths={[360, 560, 720]} sizes="(max-width: 600px) 80vw, 360px" format="webp" quality={78} style={`object-position: ${bildposition}`} />
      ) : (
        <div class="polaroid__leer" role="img" aria-label={platzhalter}>
          <span>{platzhalter}</span>
        </div>
      )
    }
  </div>
  <figcaption>{name}</figcaption>
</figure>

<style>
  .polaroid {
    position: relative;
    width: min(100%, 360px);
    margin: 0;
    padding: 16px 16px 0;
    background: var(--papier-hell);
    border: 1px solid var(--linie);
    transform: rotate(-2deg);
    transition: transform 450ms var(--kurve);
  }

  .polaroid:hover {
    transform: rotate(0deg) translateY(-6px);
  }

  .polaroid__bild {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--leinen);
  }

  .polaroid__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .polaroid__leer {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--text-gedaempft);
    font-size: 14px;
  }

  figcaption {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--schrift-hand);
    font-size: 24px;
    color: var(--tinte);
  }

  .polaroid__klammer {
    position: absolute;
    top: -22px;
    left: 26px;
    width: 18px;
    height: auto;
    overflow: visible;
  }

  .polaroid__klammer path {
    fill: none;
    stroke: var(--terrakotta-tief);
    stroke-width: 2;
    stroke-linecap: round;
  }
</style>
