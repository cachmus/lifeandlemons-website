---
/**
 * Anforderung des Jahresabschluss-Journals (Brevo, Double-Opt-in). Integrationspunkt: `journal` in src/config/site.ts.
 * Steht als letzter Abschnitt einer Seite (dunkler Schluss, Base mit dunklerSchluss).
 *
 * Felder wie im HTML-Code des Brevo-Formulars „Life&Lemons · Jahresabschluss-Journal“:
 * EMAIL, email_address_check (leer, Schutz vor Bots), locale.
 * Brevo trägt nach der Bestätigung in die Listen #11 (Journal) und #10 (Newsletter) ein; die Strecke #14 verschickt Mail 1 mit den Links.
 */
import { journal, seiten } from '../config/site';

interface Props {
  label: string;
  titel: string;
  pivot: string;
  nach?: string;
  text: string;
}

const { label, titel, pivot, nach, text } = Astro.props;
---

<section class="abschnitt abschnitt--ende journal-form" id="anfordern" aria-labelledby="anfordern-titel">
  <div class="container zwei-spalten">
    <div class="kopfblock">
      <p class="label">{label}</p>
      <h2 id="anfordern-titel" class="zeile">{titel} <span class="pivot">{pivot}</span>{nach && ` ${nach}`}</h2>
      <p class="einleitung text">{text}</p>
    </div>

    <form class="journal-form__form" action={journal.formularAdresse} method="post" data-journal novalidate>
      <div class="journal-form__feld">
        <label for="journal-email">Deine E-Mail-Adresse</label>
        <input
          id="journal-email"
          type="email"
          name="EMAIL"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="name@beispiel.de"
          aria-describedby="journal-email-fehler"
        />
        <p class="journal-form__fehler" id="journal-email-fehler" data-fehler hidden>
          Bitte gib eine gültige E-Mail-Adresse ein, zum Beispiel name@beispiel.de.
        </p>
      </div>

      <input class="journal-form__honig" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="locale" value="de" />

      <!-- Einwilligungstext: fachlich zu prüfen (wie newsletter.einwilligung in src/config/site.ts) -->
      <p class="journal-form__einwilligung">
        Mit dem Eintragen willigst du ein, dass ich dir das Journal und danach meinen Newsletter mit Impulsen zu Orientierung und
        Lebenszielen schicke. Darin erzähle ich auch von meinen Angeboten. Du bekommst zuerst eine E-Mail, mit der du deine Anmeldung
        bestätigst. Der Versand läuft über Brevo. Abmelden kannst du dich jederzeit über den Link in jeder E-Mail. Mehr dazu in der{' '}
        <a href={seiten.datenschutz}>Datenschutzerklärung</a>.
      </p>

      <button class="button" type="submit">Journal kostenlos anfordern <span class="button__pfeil" aria-hidden="true">→</span></button>
      <p class="journal-form__meldung" role="status" aria-live="polite" data-meldung></p>
    </form>
  </div>
</section>

<script>
  function einrichten(form: HTMLFormElement) {
    const meldung = form.querySelector<HTMLElement>('[data-meldung]')!;
    const fehler = form.querySelector<HTMLElement>('[data-fehler]')!;
    const email = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const knopf = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (ereignis) => {
      ereignis.preventDefault();
      meldung.textContent = '';
      const emailOk = email.value.trim() !== '' && email.validity.valid;
      fehler.hidden = emailOk;
      email.setAttribute('aria-invalid', emailOk ? 'false' : 'true');
      if (!emailOk) {
        email.focus();
        return;
      }

      knopf.disabled = true;
      try {
        const antwort = await fetch(`${form.action}${form.action.includes('?') ? '&' : '?'}isAjax=1`, {
          method: 'POST',
          body: new FormData(form),
        });
        const daten = await antwort.json().catch(() => ({}));
        if (antwort.ok && daten.success !== false) {
          form.reset();
          meldung.textContent =
            'Fast geschafft! Schau in dein Postfach und bestätige deine Anmeldung. Direkt danach schicke ich dir dein Journal.';
        } else {
          meldung.textContent = 'Das hat leider nicht geklappt. Bitte versuch es noch einmal oder schreib mir eine E-Mail.';
        }
      } catch {
        // Falls Brevo die Anfrage im Hintergrund nicht annimmt: normal absenden
        form.submit();
      } finally {
        knopf.disabled = false;
      }
    });
  }

  document.querySelectorAll<HTMLFormElement>('form[data-journal]').forEach(einrichten);
</script>

<style>
  .journal-form__form {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }

  .journal-form__feld {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    max-width: 460px;
  }

  .journal-form__feld label {
    font-weight: 700;
    font-size: 15px;
  }

  input[type='email'] {
    min-height: 52px;
    padding: 0 16px;
    font: inherit;
    font-size: 16px;
    color: var(--tinte);
    background: var(--leinen);
    border: 0;
    border-bottom: 1px solid var(--tinte);
    border-radius: 0;
    caret-color: var(--terrakotta);
    transition: background-color 250ms var(--kurve), border-color 250ms var(--kurve), box-shadow 250ms var(--kurve);
  }

  input[type='email']::placeholder {
    color: var(--text-gedaempft);
  }

  input[type='email']:focus {
    outline: none;
    background: var(--papier-hell);
    border-bottom-color: var(--terrakotta-tief);
    box-shadow: inset 0 -1px 0 var(--terrakotta-tief);
  }

  input[type='email']:focus-visible {
    outline: 2px solid var(--terrakotta-hell);
    outline-offset: 4px;
  }

  .journal-form__fehler {
    color: var(--terrakotta-hell);
    font-size: 15px;
    font-weight: 700;
  }

  .journal-form__einwilligung {
    font-size: 13.5px;
    line-height: 1.55;
    color: #c9cfc2;
    max-width: 52ch;
  }

  .journal-form__meldung:empty {
    display: none;
  }

  .journal-form__meldung {
    font-weight: 700;
    max-width: 52ch;
  }

  .journal-form__honig {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
</style>
