---
/**
 * Button für ein Angebot. Ziel und Beschriftung kommen ausschließlich aus src/config/angebote.ts.
 * Nach Buchungsschluss führt der Button automatisch zur Interessentenliste.
 * Verwendung: <AngebotButton id="kursbuch" />
 */
import { angebotNachId, aktuelleAktion } from '../config/angebote';

interface Props {
  id: string;
  variante?: 'primaer' | 'hell';
}

const { id, variante = 'primaer' } = Astro.props;
const angebot = angebotNachId(id);
const aktion = aktuelleAktion(angebot);
---

<a
  class:list={['button', { 'button--hell': variante === 'hell' }]}
  href={aktion.url}
  data-angebot={id}
  data-aktion={aktion.typ}
>
  {aktion.label}<span class="nur-screenreader">: {angebot.name}</span>
  <span class="button__pfeil" aria-hidden="true">→</span>
</a>
