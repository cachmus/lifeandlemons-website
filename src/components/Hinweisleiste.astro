---
/**
 * Schmale Hinweisleiste über dem Kopf auf jeder Seite. Inhalt und Schalter: `hinweisleiste` in src/config/site.ts.
 * Echter Link im Quelltext (gut für Suchmaschinen), kein Pop-up. Schließen merkt sich der Browser
 * für `wiederNachTagen` Tage (localStorage, nur diese eine Angabe, kein Tracking).
 */
import { Image } from 'astro:assets';
import { hinweisleiste } from '../config/site';
import symbol from '../assets/hinweis/app-symbol.png';

interface Props {
  pfad: string;
}

const { pfad } = Astro.props;
const zeigen = hinweisleiste.aktiv && !hinweisleiste.ausblendenAuf.some((anfang) => pfad.startsWith(anfang));
const schluessel = `ll-hinweis-${hinweisleiste.kennung}`;
const app = (hinweisleiste as { design?: string }).design === 'app';
const textOhneBild = (hinweisleiste as { textOhneBild?: string }).textOhneBild ?? hinweisleiste.text;
---

{
  zeigen && (
    <>
      <script is:inline define:vars={{ schluessel, tage: hinweisleiste.wiederNachTagen }}>
        try {
          var zu = Number(localStorage.getItem(schluessel) || 0);
          if (zu && Date.now() - zu < tage * 86400000) document.documentElement.setAttribute('data-hinweis-zu', '');
        } catch (e) {}
      </script>
      <aside class:list={['hinweis', { 'hinweis--app': app }]} aria-label="Hinweis" data-hinweis={schluessel}>
        <div class="container hinweis__innen">
          <a class="hinweis__link" href={hinweisleiste.ziel}>
            {app && <Image class="hinweis__symbol" src={symbol} alt="" width={40} height={40} aria-hidden="true" />}
            {!app && <span class="hinweis__marke">{hinweisleiste.marke}</span>}
            {app ? (
              <span class="hinweis__text">
                <strong>Try a Life ist da</strong><span class="hinweis__lang">: {hinweisleiste.text}</span>
              </span>
            ) : (
              <span class="hinweis__text">{textOhneBild}</span>
            )}
            <span class="hinweis__aktion">
              {hinweisleiste.linkText} <span aria-hidden="true">→</span>
            </span>
          </a>
          <button class="hinweis__zu" type="button" aria-label="Hinweis schließen" data-hinweis-schliessen>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </aside>
    </>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-hinweis]').forEach((leiste) => {
    leiste.querySelector('[data-hinweis-schliessen]')?.addEventListener('click', () => {
      try {
        localStorage.setItem(leiste.dataset.hinweis!, String(Date.now()));
      } catch {
        // Ohne Speicher bleibt die Leiste beim nächsten Seitenaufruf sichtbar
      }
      document.documentElement.setAttribute('data-hinweis-zu', '');
    });
  });
</script>

<style>
  /* Terrakotta etwas abgedunkelt (#b0552f), damit weiße Schrift den Kontrast nach WCAG AA erreicht (5,0 : 1) */
  .hinweis {
    background: #b0552f;
    color: #fff;
    font-size: 17px;
    line-height: 1.35;
  }

  :global(html[data-hinweis-zu]) .hinweis {
    display: none;
  }

  .hinweis__innen {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 60px;
  }

  .hinweis__link {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 18px;
    padding: 10px 0;
    color: inherit;
    text-decoration: none;
    text-align: center;
  }

  .hinweis__marke {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hinweis__marke::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--zitrone);
  }

  .hinweis__text {
    font-weight: 700;
  }

  .hinweis__aktion {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    background: var(--papier-hell);
    color: var(--tinte);
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
    transition: background-color 200ms var(--kurve), transform 200ms var(--kurve);
  }

  .hinweis__link:hover .hinweis__aktion,
  .hinweis__link:focus-visible .hinweis__aktion {
    background: #fff;
    transform: translateX(2px);
  }

  .hinweis__link:focus-visible,
  .hinweis__zu:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .hinweis__zu {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.85;
  }

  .hinweis__zu:hover {
    opacity: 1;
  }

  @media (max-width: 560px) {
    .hinweis {
      font-size: 15.5px;
    }
    .hinweis__text {
      flex-basis: 100%;
      order: 2;
    }
    .hinweis__aktion {
      order: 3;
    }
  }

  /* Design der App (Christine, 19.11.2026): Waldgrün und Zitrone aus Try a Life, App-Symbol statt Schriftzug */
  .hinweis--app {
    background: #326c42;
    color: #fbf1e6;
  }

  .hinweis__symbol {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    box-shadow: 0 0 0 1px rgba(251, 241, 230, 0.35);
  }

  .hinweis--app .hinweis__text {
    font-weight: 400;
  }

  .hinweis--app .hinweis__text strong {
    font-weight: 700;
  }

  .hinweis--app .hinweis__aktion {
    background: #e2e43b;
    color: #3a2f2b;
    border: 1.5px solid #3a2f2b;
    border-radius: 999px;
    padding: 7px 16px;
  }

  .hinweis--app .hinweis__link:hover .hinweis__aktion,
  .hinweis--app .hinweis__link:focus-visible .hinweis__aktion {
    background: #eef06a;
  }

  .hinweis--app .hinweis__link:focus-visible,
  .hinweis--app .hinweis__zu:focus-visible {
    outline-color: #fbf1e6;
  }

  @media (max-width: 720px) {
    .hinweis--app {
      font-size: 15.5px;
    }
    .hinweis--app .hinweis__innen {
      min-height: 56px;
    }
    .hinweis--app .hinweis__link {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 10px;
      text-align: left;
    }
    .hinweis--app .hinweis__lang {
      display: none;
    }
    .hinweis__symbol {
      width: 32px;
      height: 32px;
      border-radius: 8px;
    }
    .hinweis--app .hinweis__aktion {
      margin-left: auto;
      padding: 6px 12px;
      font-size: 14px;
    }
  }
</style>
