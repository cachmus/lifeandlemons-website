---
/**
 * Zeichen einer Phase der Methode: der Gegenstand aus Try a Life, für Phase 1 das Lebensrad als Zeichnung.
 * Genutzt auf „Wie ich arbeite“ und „Über mich“ (16.11.2026).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  symbol: ImageMetadata | null;
  /** Beschreibung des Bilds (Audit geo-audit c_image_alt) */
  alt?: string;
  klasse?: string;
}
const { symbol, alt = '', klasse } = Astro.props;
---

{
  symbol ? (
    <Image class={klasse} src={symbol} alt={alt} widths={[96, 192]} sizes="80px" />
  ) : (
    <svg class={klasse} viewBox="0 0 100 100" role="img" aria-label={alt || undefined}>
                    <circle cx="50" cy="50" r="46" fill="#fbf9f5" stroke="#bb5e3a" stroke-width="1.5" />
                    <path d="M50 50 L50 4 A46 46 0 0 1 79.6 14.8 Z" fill="#e0a487" />
                    <path d="M50 50 L79.6 14.8 A46 46 0 0 1 95.3 42 Z" fill="#d7dcce" opacity="0.9" />
                    <path d="M50 50 L95.3 42 A46 46 0 0 1 89.8 73 Z" fill="#e0a487" opacity="0.7" />
                    <path d="M50 50 L89.8 73 A46 46 0 0 1 66 93.1 Z" fill="#d8b443" opacity="0.6" />
                    <path d="M50 50 L66 93.1 A46 46 0 0 1 34 93.1 Z" fill="#d7dcce" />
                    <path d="M50 50 L34 93.1 A46 46 0 0 1 10.2 73 Z" fill="#e0a487" opacity="0.5" />
                    <path d="M50 50 L10.2 73 A46 46 0 0 1 4.7 42 Z" fill="#d8b443" opacity="0.4" />
                    <path d="M50 50 L4.7 42 A46 46 0 0 1 20.4 14.8 Z" fill="#d7dcce" opacity="0.7" />
                    <path d="M50 50 L20.4 14.8 A46 46 0 0 1 50 4 Z" fill="#e0a487" opacity="0.8" />
                    <g stroke="#93452a" stroke-width="0.8" opacity="0.6">
                      <line x1="50" y1="50" x2="50" y2="4" /><line x1="50" y1="50" x2="79.6" y2="14.8" /><line x1="50" y1="50" x2="95.3" y2="42" />
                      <line x1="50" y1="50" x2="89.8" y2="73" /><line x1="50" y1="50" x2="66" y2="93.1" /><line x1="50" y1="50" x2="34" y2="93.1" />
                      <line x1="50" y1="50" x2="10.2" y2="73" /><line x1="50" y1="50" x2="4.7" y2="42" /><line x1="50" y1="50" x2="20.4" y2="14.8" />
                    </g>
                  </svg>
  )
}
