---
/**
 * Hinweis zur Einwilligung in die Messung: Nutzung mit HeyCatch und Ladezeiten mit Netlify (seit 20.11.2026 gemeinsam).
 * Einstellungen: `messung` in src/config/site.ts. Die Sperre für Netlify steht im <head> von Base.astro, die für HeyCatch
 * in src/scripts/analytics.ts; dieser Baustein fragt, speichert die Entscheidung und schaltet HeyCatch sofort an oder aus.
 * Wortlaut fachlich zu prüfen.
 * Erneut öffnen lässt sich der Hinweis über jedes Element mit `data-einwilligung-oeffnen` (Footer, Datenschutz).
 */
import { seiten } from '../config/site';
---

<section class="einwilligung" aria-labelledby="einwilligung-titel" data-einwilligung hidden>
  <div class="container einwilligung__innen">
    <div class="einwilligung__text">
      <p id="einwilligung-titel" class="einwilligung__titel">Darf ich messen, wie diese Website genutzt wird?</p>
      <p>
        Dann erfasst der Dienst HeyCatch, welche Seiten du aufrufst und was du anklickst, und mein Hoster Netlify misst, wie schnell die
        Seiten laden. HeyCatch speichert dafür eine zufällige Kennung in deinem Browser. Die Daten gehen in die USA. Du kannst deine Wahl
        jederzeit im Fußbereich ändern. Mehr dazu in der{' '}
        <a href={`${seiten.datenschutz}#messung`}>Datenschutzerklärung</a>.
      </p>
    </div>
    <div class="einwilligung__knoepfe">
      <button class="button button--hell button--klein" type="button" data-wahl="nein">Ablehnen</button>
      <button class="button button--hell button--klein" type="button" data-wahl="ja">Zulassen</button>
    </div>
  </div>
</section>

<script>
  import { messung } from '../config/site';
  import { analytics } from '../scripts/analytics';

  const banner = document.querySelector<HTMLElement>('[data-einwilligung]');

  function gespeicherteWahl(): 'ja' | 'nein' | null {
    try {
      const [wahl, zeit] = (localStorage.getItem(messung.speicherSchluessel) ?? '').split(':');
      if ((wahl === 'ja' || wahl === 'nein') && Date.now() - Number(zeit) < messung.gueltigTage * 86_400_000) return wahl;
    } catch {
      // Speicher gesperrt: dann gilt keine Einwilligung
    }
    return null;
  }

  function zeigen(fokus: boolean) {
    if (!banner) return;
    banner.hidden = false;
    if (fokus) banner.querySelector<HTMLButtonElement>('[data-wahl="nein"]')?.focus();
  }

  if (banner) {
    banner.querySelectorAll<HTMLButtonElement>('[data-wahl]').forEach((knopf) =>
      knopf.addEventListener('click', () => {
        try {
          localStorage.setItem(messung.speicherSchluessel, `${knopf.dataset.wahl}:${Date.now()}`);
        } catch {
          // Ohne Speicher wird beim nächsten Seitenaufruf erneut gefragt
        }
        // HeyCatch sofort an- oder abschalten, nicht erst beim nächsten Seitenaufruf
        if (knopf.dataset.wahl === 'ja') analytics.optInCapturing();
        else analytics.optOutCapturing();
        banner.hidden = true;
      }),
    );

    // Seit HeyCatch (20.11.2026) immer fragen, solange keine gültige Entscheidung gespeichert ist
    if (gespeicherteWahl() === null) zeigen(false);
  }

  document.querySelectorAll<HTMLElement>('[data-einwilligung-oeffnen]').forEach((element) =>
    element.addEventListener('click', () => zeigen(true)),
  );
</script>

<style>
  .einwilligung {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    background: var(--tinte);
    color: var(--kalk);
    border-top: 1px solid var(--terrakotta-hell);
    padding: 20px 0;
  }

  .einwilligung[hidden] {
    display: none;
  }

  .einwilligung__innen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 40px;
  }

  .einwilligung__text {
    flex: 1 1 32rem;
    font-size: 14.5px;
    line-height: 1.55;
  }

  .einwilligung__text p {
    margin: 0;
  }

  .einwilligung__titel {
    font-weight: 700;
    margin-bottom: 4px !important;
  }

  .einwilligung a {
    color: var(--kalk);
    text-decoration-color: var(--terrakotta-hell);
  }

  .einwilligung__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
