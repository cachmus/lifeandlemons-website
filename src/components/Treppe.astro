---
/**
 * Die Treppe mit den sieben Phasen der Methode (Positionierungspapier V4, § 4):
 * sechs in Modul 1 (durchgezogen), eine in Modul 2 (gestrichelt).
 * Zeichnet sich einmalig, sobald sie ins Bild kommt. Ohne JavaScript ist sie sofort vollständig.
 */
const stufen = [
  'Verstehen, wo du stehst',
  'Erkennen, was dich bremst',
  'Drei mögliche Leben entwerfen',
  'Spüren, welcher Entwurf dich anzieht',
  'Klären, was dir wichtig ist',
  'Ausprobieren und nachjustieren',
  'Im Alltag verankern',
];
/** Anzahl der Phasen in Modul 1; die übrigen gehören zu Modul 2 */
const modul1 = 6;

// Raster: sieben gleich breite Trittflächen, Steigung 34 Einheiten
const breite = 1200;
const hoehe = 260;
const tritt = breite / stufen.length;
const steigung = 34;
const y = (i: number) => hoehe - 16 - i * steigung;
const letzte = stufen.length - 1;

let durchgezogen = `M 2 ${y(0)} H ${tritt}`;
for (let i = 1; i < modul1; i++) durchgezogen += ` V ${y(i)} H ${tritt * (i + 1)}`;
let gestrichelt = `M ${tritt * modul1} ${y(modul1 - 1)}`;
for (let i = modul1; i < stufen.length; i++) gestrichelt += ` V ${y(i)} H ${i === letzte ? breite - 14 : tritt * (i + 1)}`;
const endpunkt = { x: breite - 9, y: y(letzte) };
---

<figure class="treppe" data-treppe>
  <div class="treppe__module" aria-hidden="true" style={`grid-template-columns: ${modul1}fr ${stufen.length - modul1}fr`}>
    <span class="treppe__modul">Modul 1</span>
    <span class="treppe__modul treppe__modul--2">Modul 2</span>
  </div>
  <svg
    viewBox={`0 0 ${breite} ${hoehe}`}
    role="img"
    aria-labelledby="treppe-titel"
    preserveAspectRatio="xMidYMid meet"
  >
    <title id="treppe-titel">Eine Treppe mit sieben Phasen: sechs in Modul 1, eine in Modul 2</title>
    <path class="treppe__linie" d={durchgezogen} pathLength="1" />
    <path class="treppe__strich" d={gestrichelt} />
    <circle class="treppe__punkt" cx={endpunkt.x} cy={endpunkt.y} r="5" />
  </svg>
  <ol class="treppe__stufen">
    {
      stufen.map((text, i) => (
        <li class:list={{ 'treppe__stufe--2': i >= modul1 }}>
          <span class="treppe__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          {text}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .treppe {
    margin: 0;
  }

  .treppe__module {
    display: grid;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-gedaempft);
    margin-bottom: 8px;
  }

  .treppe__modul--2 {
    color: var(--terrakotta-tief);
    padding-left: 4px;
  }

  svg {
    width: 100%;
    overflow: visible;
  }

  path,
  circle {
    vector-effect: non-scaling-stroke;
    fill: none;
  }

  .treppe__linie {
    stroke: var(--tinte);
    stroke-width: 1.8;
  }

  .treppe__strich {
    stroke: var(--terrakotta);
    stroke-width: 1.8;
    stroke-dasharray: 6 7;
  }

  .treppe__punkt {
    fill: var(--terrakotta);
    stroke: none;
  }

  .treppe__stufen {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 10px;
    font-size: 13.5px;
    line-height: 1.4;
  }

  .treppe__stufen li {
    padding-right: 8px;
  }

  .treppe__nr {
    display: block;
    font-family: var(--schrift-titel);
    font-size: 20px;
    color: var(--terrakotta);
    margin-bottom: 2px;
  }

  .treppe__stufe--2 {
    color: var(--terrakotta-tief);
  }

  @media (max-width: 700px) {
    .treppe__stufen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 20px;
      font-size: 15px;
    }
  }

  /* Zeichnen beim Erscheinen: durchgezogener Teil 1,8 s, danach der gestrichelte Teil */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .treppe__linie {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 1800ms var(--kurve);
    }
    :global(.js) .treppe__strich,
    :global(.js) .treppe__punkt {
      opacity: 0;
      transition: opacity 600ms var(--kurve) 1500ms;
    }
    :global(.js) .treppe.on .treppe__linie {
      stroke-dashoffset: 0;
    }
    :global(.js) .treppe.on .treppe__strich,
    :global(.js) .treppe.on .treppe__punkt {
      opacity: 1;
    }
  }
</style>
