---
/**
 * „Blick ins Buch“: Doppelseiten aus Try a Life · Das Workbook (Neugestaltung, 16.11.2026; seit 21.11.2026 aus dem PDF).
 * Quelle: Try-a-Life_Das-Workbook.pdf aus V28 (Seiten 24/25, 28/29, 66/67, 92/93, 122/123, 154/155, 172/173, 186/187).
 * Bildunterschriften geprüft gegen die Seiten.
 */
import BildSlider from './BildSlider.astro';
import s1 from '../assets/blick-ins-buch/01-bevor-du-anfaengst.jpg';
import s2 from '../assets/blick-ins-buch/02-an-der-schwelle.jpg';
import s3 from '../assets/blick-ins-buch/03-drei-moegliche-leben.jpg';
import s4 from '../assets/blick-ins-buch/04-drei-entwuerfe.jpg';
import s5 from '../assets/blick-ins-buch/05-werte.jpg';
import s6 from '../assets/blick-ins-buch/06-entscheiden.jpg';
import s7 from '../assets/blick-ins-buch/07-probezeit.jpg';
import s8 from '../assets/blick-ins-buch/08-zukunfts-collage.jpg';

interface Props {
  kennung?: string;
  ueberschriftEbene?: 'h2' | 'h3';
}
const { kennung = 'buch', ueberschriftEbene = 'h3' } = Astro.props;

const bilder = [
  { bild: s1, text: 'Bevor du anfängst, schaust du, wie zufrieden du gerade mit neun Bereichen deines Lebens bist.', alt: 'Doppelseite „Das Lebensrad“ und „Deine Momentaufnahme im Lebensrad“ mit einem Rad aus neun Lebensbereichen' },
  { bild: s2, text: 'Teil I, An der Schwelle: Du findest heraus, worauf du wartest und was dich bremst.', alt: 'Doppelseite zum Auftakt von Teil I „An der Schwelle“ mit Überblick über die Einheiten und dem Foto einer Teetasse' },
  { bild: s3, text: 'Teil II, Drei mögliche Leben: Du entdeckst, was dir Energie gibt, und entwirfst deine Zukunftsentwürfe.', alt: 'Doppelseite zum Auftakt von Teil II „Drei mögliche Leben“ mit Überblick über die Einheiten 3 bis 6 und einem Foto' },
  { bild: s4, text: 'Drei Bögen, drei Fragen: Weitergehen, Umsteigen, Wagen.', alt: 'Doppelseite „So gestaltest du deine drei Zukunftsentwürfe“ mit den Fragen der drei Bögen und dem Aquarell eines Hauses am Hang' },
  { bild: s5, text: 'Werte zur Orientierung helfen dir zu benennen, was dir wirklich wichtig ist.', alt: 'Doppelseite „Werte zur Orientierung“ mit Wertegruppen wie Sicherheit, Wachstum, Freiheit und Zugehörigkeit in farbigen Kreisen' },
  { bild: s6, text: 'Am Ende von Teil II wird aus drei Möglichkeiten eine Richtung.', alt: 'Doppelseite „Deine Entscheidung“ mit Feldern zum Ankreuzen und Schreiben' },
  { bild: s7, text: 'In der Probezeit lebst du deine Richtung vierzehn Tage im Alltag und hältst fest, wie es dir damit geht.', alt: 'Doppelseite „Probezeit-Journal“ mit Tabellen für vierzehn Tage' },
  { bild: s8, text: 'Auf der Zukunfts-Collage sammelst du deine wichtigsten Erkenntnisse an einer Stelle.', alt: 'Doppelseite „Mein Zukunfts-Ich“ mit Zetteln zum Ausfüllen wie auf einer Pinnwand' },
];
---

<BildSlider
  kennung={kennung}
  kennzeile="Blick ins Buch"
  titel="So sieht das Workbook innen aus"
  listenLabel="Doppelseiten aus dem Workbook"
  bilder={bilder}
  format="quer"
  hinweis="Doppelseiten aus dem Workbook, 205 Seiten als PDF."
  ueberschriftEbene={ueberschriftEbene}
/>
